{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": false,
    "allowJs": false,
    "skipLibCheck": true
    ,"allowImportingTsExtensions": true
  },
  "include": ["src/next/**/*.ts"]
}
